 static void events_block(uint32_t n);
+/* (muse-midi-dx: the page's wave screen. Each part's last PART_SCOPE_N samples, as it goes into the mix (after MUTE / solo
+ * and LEVEL, before pan and the effects), 16-bit; part_scope_pos: where the next block goes. A part silent in a block (not
+ * rendered, a MIDI track, past the parts in use) has zeros there. emu/game_glue.c hands them to the page) */
+#define PART_SCOPE_N 2048u
+static int16_t part_scope[NPART][PART_SCOPE_N];
+static uint32_t part_scope_pos;
+static void part_scope_put(uint32_t p, const int32_t *b, uint32_t n, int32_t lvl)
+{
+    for (uint32_t i = 0; i < n; i++)
+        part_scope[p][(part_scope_pos + i) & (PART_SCOPE_N - 1u)] = (int16_t)clamp(((b[i] >> 4) * lvl) >> 12, -32767, 32767);
+}
 #if MELODEE_USB_AUDIO
